# StreamLingo environment configuration
# Copy this file to `.env` and update values.

# Core languages
SL_SOURCE_LANGUAGE=hi
SL_TARGET_LANGUAGE=en

# Audio + chunking
SL_SAMPLE_RATE_HZ=16000
SL_FRAME_MS=30
SL_CHUNK_SECONDS=2.0
SL_VAD_RMS_THRESHOLD=0.010

# Controlled latency + context
SL_TARGET_DELAY_SECONDS=7.0
SL_CONTEXT_MAX_SENTENCES=6

# Whisper
SL_WHISPER_MODEL=base
SL_WHISPER_DEVICE=auto

# Input device index from GET /devices (leave empty to use default input)
# SL_INPUT_DEVICE_INDEX=0

# Translation provider: mock or openai
SL_TRANSLATION_PROVIDER=mock
SL_OPENAI_MODEL=gpt-4o-mini

# Required only when SL_TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=

# Logging
SL_SAVE_LOGS=true
SL_LOGS_DIR=runs
