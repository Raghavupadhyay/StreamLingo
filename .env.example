# StreamLingo environment configuration
# Copy this file to `.env` and update values.

# Core languages
SL_SOURCE_LANGUAGE=hi
SL_TARGET_LANGUAGE=en

# Audio + chunking
SL_SAMPLE_RATE_HZ=16000
SL_FRAME_MS=30
SL_CHUNK_SECONDS=1.0
SL_VAD_RMS_THRESHOLD=0.010

# Controlled latency + context
SL_TARGET_DELAY_SECONDS=1.8
SL_CONTEXT_MAX_SENTENCES=4

# Whisper
SL_WHISPER_MODEL=small
SL_WHISPER_DEVICE=auto
SL_WHISPER_COMPUTE_TYPE=int8
SL_WHISPER_BEAM_SIZE=3

# Input device index from GET /devices (leave empty to use default input)
# SL_INPUT_DEVICE_INDEX=0

# Translation provider: mock, openai, or ollama
SL_TRANSLATION_PROVIDER=ollama
SL_OPENAI_MODEL=gpt-4o-mini
SL_OLLAMA_MODEL=qwen2.5:7b-instruct
SL_OLLAMA_BASE_URL=http://127.0.0.1:11434
SL_OLLAMA_TIMEOUT_SECONDS=10

# Required only when SL_TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=

# Logging
SL_SAVE_LOGS=true
SL_LOGS_DIR=runs
