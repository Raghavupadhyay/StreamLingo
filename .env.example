

# Core
SL_SOURCE_LANGUAGE=hi        # language being spoken (hi=Hindi, ja=Japanese, etc)
SL_TARGET_LANGUAGE=en        # language to translate into

# Audio — SET THIS to the index from Step 3
SL_INPUT_DEVICE_INDEX=0      # <-- your mic/device index here

# Audio settings
SL_SAMPLE_RATE_HZ=16000
SL_FRAME_MS=30
SL_CHUNK_SECONDS=1.0
SL_VAD_RMS_THRESHOLD=0.010

# Latency
SL_TARGET_DELAY_SECONDS=1.8
SL_CONTEXT_MAX_SENTENCES=4

# Whisper
SL_WHISPER_MODEL=small       # base=fast+less accurate, small=better balance
SL_WHISPER_DEVICE=auto
SL_WHISPER_COMPUTE_TYPE=int8
SL_WHISPER_BEAM_SIZE=3

# Translation — start with ollama (local) or mock (no translation, just test)
SL_TRANSLATION_PROVIDER=mock   # mock | ollama | openai

# Ollama (if using)
SL_OLLAMA_MODEL=qwen2.5:7b-instruct
SL_OLLAMA_BASE_URL=http://127.0.0.1:11434
SL_OLLAMA_TIMEOUT_SECONDS=10

# OpenAI (if using)
# SL_TRANSLATION_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# SL_OPENAI_MODEL=gpt-4o-mini

# Smart VAD (leave false until base pipeline works)
SL_USE_SMART_VAD=false

# Logging
SL_SAVE_LOGS=true
SL_LOGS_DIR=runs
